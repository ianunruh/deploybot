DEPLOYBOT_ADDR=:8080
DEPLOYBOT_SPECS_DIR=/specs
DEPLOYBOT_OPS_REPO=/ops
DEPLOYBOT_OPS_REPO_URL=https://github.com/ianunruh/kcloud-ops
DEPLOYBOT_CONFIG=/config/deploybot.yaml
DEPLOYBOT_APPLY=1
DEPLOYBOT_PUSH=1
DEPLOYBOT_SYNC=1
# Enable scheduled auto-pin on exactly one cluster, not both:
# DEPLOYBOT_AUTO_PIN=1
KUBECONFIG=/config/kubeconfig
