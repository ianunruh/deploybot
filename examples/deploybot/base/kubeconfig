apiVersion: v1
kind: Config
current-context: homelab
clusters:
  - name: homelab
    cluster:
      server: https://kubernetes.default.svc
      certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
  - name: prod-sjc1
    cluster:
      server: https://kubernetes.sjc1.prod.kcloud.io:6443
      certificate-authority-data: 
contexts:
  - name: homelab
    context:
      cluster: homelab
      user: homelab
  - name: prod-sjc1
    context:
      cluster: prod-sjc1
      user: prod-sjc1
users:
  - name: homelab
    user:
      tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
  - name: prod-sjc1
    user:
      tokenFile: /var/run/secrets/deploybot/clusters/prod
